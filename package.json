{
  "name": "ai-ticket-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Ticket Management System with Express, React, TypeScript, and Bun",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "bun run dev:server",
    "dev:all": "bun --filter \"*\" dev",
    "dev:server": "cd server && bun run dev",
    "dev:client": "cd client && bun run dev",
    "build": "bun run build:client && bun run build:server",
    "build:server": "cd server && bun run build",
    "build:client": "cd client && bun run build",
    "db:migrate": "cd server && bun x prisma migrate dev",
    "db:seed": "cd server && bun run seed",
    "db:studio": "cd server && bun x prisma studio",
    "db:setup-test": "cd server && npx tsx scripts/setup-test-db.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "keywords": [
    "bun",
    "express",
    "react",
    "typescript",
    "ticket-management",
    "ai",
    "claude"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
