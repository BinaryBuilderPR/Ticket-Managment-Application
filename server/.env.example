# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL - Helpdesk Database)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/helpdesk?schema=public"

# Database Session Secret & Better Auth
SESSION_SECRET="super-secure-random-session-secret-key-at-least-32-chars"
BETTER_AUTH_SECRET="super-secure-random-session-secret-key-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:5000"

# Seed Credentials (Admin & Support Agent)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="password123"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="password123"
ADMIN_NAME="System Administrator"

SEED_AGENT_EMAIL="agent@example.com"
SEED_AGENT_PASSWORD="password123"
AGENT_EMAIL="agent@example.com"
AGENT_PASSWORD="password123"
AGENT_NAME="Support Agent"

# AI / LLM Configuration (Anthropic Claude)
ANTHROPIC_API_KEY=""
CLAUDE_CLASSIFICATION_MODEL="claude-3-5-haiku-20241022"
CLAUDE_DRAFTING_MODEL="claude-3-5-sonnet-20241022"

# Email Service Provider (SendGrid / Mailgun)
EMAIL_PROVIDER="sendgrid"
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="support@institution.edu"

