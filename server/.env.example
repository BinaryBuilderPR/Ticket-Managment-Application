# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL - Helpdesk Database)
# Replace with your actual PostgreSQL connection string
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/helpdesk?schema=public"

# ⚠️  SECURITY — Generate unique random secrets before running the server.
#    Command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#    NEVER use the same value for both, and NEVER commit real secrets to version control.
SESSION_SECRET=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5000"

# Seed Credentials — used only by `npm run seed` to create initial staff accounts.
# Choose strong, unique passwords. These are NOT default login credentials for production.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="System Administrator"

SEED_AGENT_EMAIL=""
SEED_AGENT_PASSWORD=""
AGENT_EMAIL=""
AGENT_PASSWORD=""
AGENT_NAME="Support Agent"

# AI / LLM Configuration (Anthropic Claude)
ANTHROPIC_API_KEY=""
CLAUDE_CLASSIFICATION_MODEL="claude-3-5-haiku-20241022"
CLAUDE_DRAFTING_MODEL="claude-3-5-sonnet-20241022"

# Email Service Provider (SendGrid / Mailgun)
EMAIL_PROVIDER="sendgrid"
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
